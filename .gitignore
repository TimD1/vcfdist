# ignore certain file types
*.a
.*.swp
*.o
*.log
*.txt
*.bed
*.nfs*
*.tsv
*gmon.out
*.svg
*.vcf
*.pdf
*.gz
*.gprof
*.png
*.json
*.log
*.aux
src/test
__pycache__
**/.DS_Store
**/*.dSYM/
.claude/

# ignore binaries
src/vcfdist
tests/unit/build/test_vcfdist

# ignore analysis
analysis/*/*/
analysis-v2/*/*/
analysis-v2/hla

# ignore input/output
data/
out/

# don't track test cases
test/
issues/

# ignore auto-generated documentation
src/docs/

# v3 design docs are tracked; the SOW and the executed benchmarking plan are not
docs/deliverables/D0_vcfdist-v3-SOW.md
docs/deliverables/D7_vcfdist-v3-benchmarking-plan.md
