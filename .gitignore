# ignore certain file types
*.a
.*.swp
*.o
*.log
*.txt
*.bed
*.nfs*
*.tsv
*gmon.out
*.svg
*.vcf
*.pdf
*.gz
*.gprof
*.png
*.json
!.claude-github-settings.json
*.log
*.aux
src/test
__pycache__
.venv/
**/.DS_Store
**/*.dSYM/

# Claude
.claude/*
!.claude/skills/
docs/superpowers/

# ignore binaries
src/vcfdist
tests/unit/build/test_vcfdist

# ignore analysis
analysis/*/*/
analysis-v2/*/*/
analysis-v2/hla

# ignore input/output
data/
out/

# don't track test cases
test/
issues/

# ignore auto-generated documentation
src/docs/
docs/deliverables/

# track the tiny unit-test fixtures, which the 'data/' and per-extension rules above would ignore
# (the directory must be un-ignored first, or git never descends into it to apply these rules)
!tests/unit/data/
!tests/unit/data/*.bed
!tests/unit/data/*.fasta
!tests/unit/data/*.gz
!tests/unit/data/*.tsv
!tests/unit/data/*.txt
!tests/unit/data/*.vcf
